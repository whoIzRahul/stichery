{
  "name": "crocheter",
  "version": "0.1.0",
  "description": "A ecommerce application client side ",
  "keywords": [
    "nextjs",
    "react",
    "typescript",
    "tailwindcss",
    "starter",
    "template",
    "redux"
  ],
  "author": "Rahuley",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "format:check": "biome format",
    "ci:check": "biome ci",
    "lint-staged": "lint-staged",
    "env:sync": "tsx scripts/sync-env.ts",
    "check:deprecated": "tsx scripts/check-deprecated.ts",
    "type-check": "tsc --noEmit",
    "prepare": "husky",
    "commit": "cz",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "validate": "yarn ci:check && yarn type-check && yarn check:deprecated && yarn test && yarn build"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "@teispace/next-themes": "^0.5.0",
    "framer-motion": "^12.39.0",
    "next": "^16.2.6",
    "next-intl": "^4.12.0",
    "pino": "^10.3.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-redux": "^9.3.0",
    "react-secure-storage": "^1.3.2",
    "redux": "^5.0.1",
    "redux-persist": "^6.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@commitlint/cli": "^20.5.2",
    "@commitlint/config-conventional": "^20.5.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "pino-pretty": "^13.1.3",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
